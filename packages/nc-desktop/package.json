{
  "name": "nc-desktop",
  "version": "0.301.3",
  "description": "NocoDB Desktop Application for macOS, Windows, and Linux with built-in M3ta-Os REA MCP integration",
  "main": "src/main.js",
  "private": true,
  "author": {
    "name": "NocoDB & M3ta-Os",
    "url": "https://nocodb.com"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist:mac": "electron-builder --mac",
